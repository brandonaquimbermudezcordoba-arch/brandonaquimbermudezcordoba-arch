# Copia este archivo como .env (local) o carga estas variables en el panel de tu proveedor (Railway: pestaña Variables).
# NUNCA subas el archivo .env a GitHub.

# --- Servidor ---
PORT=3000                       # Railway lo define solo
DATA_DIR=./data                 # Carpeta de la base de datos y las imágenes. En Railway: la ruta de tu Volumen (ej.: /data)
TZ=America/Lima                 # Zona horaria del negocio (ya es el valor por defecto)

# --- Seguridad ---
TRUST_PROXY=0                   # Ponlo en 1 detrás de Railway/Render/Nginx: así se registra la IP real de cada acceso
COOKIE_SECURE=0                 # Ponlo en 1 si publicas con HTTPS y tu proveedor no envía el encabezado x-forwarded-proto
SESION_INACTIVIDAD_MIN=120      # Minutos sin actividad antes de cerrar la sesión
SESION_MAX_HORAS=10             # Duración máxima de una sesión

# --- Primer arranque (cuentas del personal) ---
# Se crea una cuenta por persona (tonen.bermudez, eda.cordova, brandon.bermudez) con clave aleatoria que se imprime UNA vez en la consola.
ADMIN_PASSWORD=                 # Opcional (mín. 10 caracteres, letras y números): clave inicial de tonen.bermudez. Vacío = también aleatoria
ADMIN_USER=admin                # Solo se usa con la base vacía (SIN_DATOS=1): nombre del administrador genérico

# --- Datos ---
SIN_DATOS=0                     # 0 = arrancar con el catálogo e inventario de partida y el personal. 1 = base totalmente VACÍA

# --- Acceso con Google (opcional; también se configura desde el panel: Configuración empresarial → Acceso con Google) ---
GOOGLE_CLIENT_ID=               # console.cloud.google.com → Credenciales → ID de cliente de OAuth (Aplicación web)
GOOGLE_CLIENT_SECRET=           # Secreto del cliente. Si defines estas dos variables, mandan sobre lo guardado en el panel
PUBLIC_URL=                     # Dirección pública, ej.: https://tudominio.com (sin ruta). Vacío = se deduce de la dirección con la que se visita
CLAVE_CIFRADO=                  # Opcional: clave para cifrar el secreto guardado en la base. Vacío = se crea data/clave-cifrado.key (respáldala con data/)
